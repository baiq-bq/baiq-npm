{
  "name": "@baiq/activities",
  "version": "0.1.0",
  "description": "Zod schemas and TypeScript types for BAIQ activity components.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/public/*.d.ts",
      "import": "./dist/public/*.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "prebuild": "node scripts/generate-public-modules.mjs",
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist src/public",
    "prepack": "npm run build",
    "test": "echo \"No tests yet\""
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
